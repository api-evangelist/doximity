          "name": "Start the Authorization Code flow",
          "request": {
            "name": "Start the Authorization Code flow",
            "description": {
              "content": "Redirect the user's browser here to begin the Authorization Code grant with PKCE. On approval Doximity redirects back to redirect_uri with a short-lived authorization code and state.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "oauth",
                "authorize"
              ],
              "host": [
                "{{baseUrl}}"
              ],
